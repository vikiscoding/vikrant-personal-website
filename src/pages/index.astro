---
// Home page (ADR-022): outcome-first headline, the record in three short paragraphs, what I hold a team to,
// a short path, proof you can open, writing, contact. All copy lives in src/data/profile.ts.
// The short path is a walk, not a fifth proof item (ADR-022, ADR-023).
import Base from "../layouts/Base.astro";
import { profile } from "../data/profile";
---

<Base title={`${profile.name} · ${profile.headline}`} description={profile.description}>
  <h1>{profile.headline}</h1>
  <p class="intro">{profile.intro}</p>

  {profile.story.map((line) => <p>{line}</p>)}
  <p><strong>{profile.principles.lead}</strong> {profile.principles.text}</p>
  <p><strong>{profile.aim.lead}</strong> {profile.aim.text}</p>

  <h2>{profile.shortPath.heading}</h2>
  <p>{profile.shortPath.lede}</p>
  <ol class="path">
    {
      profile.shortPath.steps.map((step) => (
        <li>
          <a href={step.href}>{step.label}</a>
          {" — "}
          {step.text}
        </li>
      ))
    }
  </ol>

  <h2>Proof you can open</h2>
  <ul class="proof">
    {
      profile.proof.map((x) => (
        <li class="card">
          <h3>
            {x.title}
            {"chip" in x && x.chip && <span class="chip">{x.chip}</span>}
          </h3>
          <p>{x.text}</p>
          {"scope" in x && x.scope && <p class="scope">Scope: {x.scope}</p>}
          <p class="actions">
            {x.links.map((l, i) => (
              <>
                {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
                <a class={i === 0 ? "primary" : undefined} href={l.href}>{l.label}</a>
              </>
            ))}
          </p>
        </li>
      ))
    }
  </ul>

  <h2>Writing</h2>
  <p>{profile.writingBlurb} <a href="/notes/">Read the essays →</a></p>

  <p class="links">
    {profile.links.resume && <><a href={profile.links.resume}>Résumé (PDF)</a> · </>}
    {profile.links.email && <><a href={profile.links.email}>Email</a> · </>}
    <a href={profile.links.linkedin} rel="me">LinkedIn</a>
    {profile.links.github && <> · <a href={profile.links.github} rel="me">GitHub</a></>}
  </p>
</Base>

<style>
  h1 { margin-bottom: 0.5rem; }
  .intro { font-size: 1.1875rem; margin: 0 0 1.5rem; }
  h2 { font-size: 1.125rem; margin: 2.5rem 0 0.75rem; }
  .path { margin: 0.25rem 0 0; padding-left: 1.25rem; }
  .path li { margin: 0.45rem 0; }
  .proof { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .card { border: 1px solid var(--line); border-radius: 8px; padding: 1rem 1.25rem; }
  .card h3 { margin: 0 0 0.35rem; font-size: 1rem; }
  .card p { margin: 0.3rem 0; }
  .chip { display: inline-block; margin-left: 0.5rem; padding: 0 0.45rem; border: 1px solid var(--good); border-radius: 999px; color: var(--good); font-size: 0.75rem; font-weight: 600; line-height: 1.5; vertical-align: 0.1rem; }
  .scope { color: var(--muted); font-size: 0.9375rem; }
  .actions { margin-top: 0.6rem !important; font-size: 0.9375rem; }
  .actions .primary { font-weight: 600; }
  .sep { color: var(--muted); }
  .links { margin: 2.5rem 0 0; word-spacing: 0.15em; line-height: 2; }
</style>
