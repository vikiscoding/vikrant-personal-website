---
// Reliability dashboard (ADR-013). The Worker fills [data-dashboard] from the SLI ledger when DASHBOARD_MODE allows.
// Styles are global under .dash because the markup is injected at the edge, after Astro's scoped-style build.
import Base from "../layouts/Base.astro";
---

<Base title="Reliability · vikrantsingh.fyi" description="Live service level objectives, error budgets and failures for vikrantsingh.fyi.">
  <p><a href="/notes/how-this-site-is-run/">← How this site is run</a></p>
  <h1>Reliability</h1>
  <p>
    This site runs one small scheduled job and is checked from outside every 5 minutes. Below is how that is going,
    straight from its own records.
  </p>
  <div data-dashboard>
    <p class="dash-note">Reliability data is being collected. The live numbers appear here once the first 30-day window is complete.</p>
  </div>
</Base>

<style is:global>
  .dash { display: grid; gap: 1.25rem; margin-top: 1.5rem; }
  .dash h2 { font-size: 1rem; margin: 0 0 0.5rem; }
  .dash-card, .dash-section { border: 1px solid var(--line); border-radius: 10px; padding: 1rem 1.25rem; background: var(--bg); }
  .dash-section { border: 0; padding: 0; background: none; }
  .dash-grid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 560px) { .dash-grid { grid-template-columns: 1fr 1fr; } }

  .dash-card { border-left: 4px solid var(--none); }
  .dash-card[data-state="good"] { border-left-color: var(--good); }
  .dash-card[data-state="warn"] { border-left-color: var(--warn); }
  .dash-card[data-state="bad"] { border-left-color: var(--bad); }

  .dash-big { font-size: 1.75rem; font-weight: 650; line-height: 1.2; margin: 0.25rem 0; font-variant-numeric: tabular-nums; }
  .dash-live .dash-big { font-size: 1.25rem; display: flex; align-items: center; gap: 0.5rem; }
  .dash-dot { width: 0.7rem; height: 0.7rem; border-radius: 50%; background: var(--none); flex: none; }
  .dash-live[data-state="good"] .dash-dot { background: var(--good); }
  .dash-live[data-state="bad"] .dash-dot { background: var(--bad); }
  .dash-live[data-state="warn"] .dash-dot { background: var(--warn); }

  .dash-small { font-size: 0.875rem; margin: 0.35rem 0; }
  .dash-muted { color: var(--muted); }
  .dash-collecting { border: 1px solid var(--line); border-left: 4px solid var(--accent); border-radius: 10px; padding: 0.9rem 1.1rem; background: var(--surface); display: grid; gap: 0.6rem; }
  .dash-collecting p { margin: 0; }
  .dash-collecting-head { font-weight: 650; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .dash-chip { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.02em; padding: 0.15rem 0.55rem; border-radius: 999px; background: var(--accent); color: var(--bg); }
  .dash-progress { height: 0.5rem; border-radius: 999px; background: var(--line); overflow: hidden; }
  .dash-progress span { display: block; height: 100%; border-radius: 999px; background: var(--accent); }
  .dash-note { font-size: 0.875rem; color: var(--muted); background: var(--surface); border-radius: 8px; padding: 0.6rem 0.9rem; margin: 0; }
  .dash-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .dash-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 0.5rem 1rem; margin: 0.75rem 0 0; }
  .dash-facts dt { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .dash-facts dd { margin: 0; font-variant-numeric: tabular-nums; }

  .dash-bar { height: 0.5rem; border-radius: 999px; background: var(--surface); overflow: hidden; margin: 0.75rem 0 0.25rem; }
  .dash-bar span { display: block; height: 100%; background: var(--good); }
  .dash-card[data-state="warn"] .dash-bar span { background: var(--warn); }
  .dash-card[data-state="bad"] .dash-bar span { background: var(--bad); }

  .dash-strip-row { margin-bottom: 0.5rem; }
  .dash-strip-row .dash-small { margin: 0 0 0.25rem; }
  .dash-strip { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(30, 1fr); gap: 3px; }
  .dash-strip li { height: 1.5rem; border-radius: 3px; background: var(--none); }
  .dash-strip li[data-state="good"], .dash-legend span[data-state="good"] { background: var(--good); }
  .dash-strip li[data-state="warn"], .dash-legend span[data-state="warn"] { background: var(--warn); }
  .dash-strip li[data-state="bad"], .dash-legend span[data-state="bad"] { background: var(--bad); }
  .dash-strip-axis { display: flex; justify-content: space-between; margin: 0.25rem 0 0; }
  .dash-legend span { display: inline-block; width: 0.7rem; height: 0.7rem; border-radius: 2px; background: var(--none); margin: 0 0.3rem 0 0.6rem; vertical-align: -0.05rem; }
  .dash-legend span:first-child { margin-left: 0; }

  .dash-burn { margin: 0; }
  .dash-burn svg { display: block; width: 100%; height: 4.5rem; overflow: visible; }
  .dash-burn figcaption { margin: 0.4rem 0 0.2rem; }
  .dash-burn .dash-small { margin: 0.25rem 0 0; }
  .burn-ref { stroke: var(--line); stroke-dasharray: 3 3; stroke-width: 1; }
  .burn-zero { stroke: var(--bad); stroke-width: 1; opacity: 0.6; }
  .burn-hb, .burn-job { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .burn-hb { stroke: var(--accent); }
  .burn-job { stroke: var(--fg); stroke-dasharray: 5 3; }
  .burn-key { display: inline-block; width: 1.1rem; height: 0; border-top: 2px solid var(--accent); vertical-align: middle; margin: 0 0.35rem 0 0; }
  .burn-key-job { border-top: 2px dashed var(--fg); margin-left: 0.8rem; }

  .dash-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; font-variant-numeric: tabular-nums; }
  .dash-table th, .dash-table td { text-align: left; padding: 0.4rem 0.5rem; border-bottom: 1px solid var(--line); }
  .dash-table thead th { color: var(--muted); font-weight: 500; }

  .dash-events { list-style: none; margin: 0; padding: 0; font-size: 0.875rem; }
  .dash-events li { display: grid; grid-template-columns: 9.5rem 1fr; gap: 0.75rem; padding: 0.45rem 0; border-bottom: 1px solid var(--line); }
  .dash-events time { color: var(--muted); font-variant-numeric: tabular-nums; }
  @media (max-width: 480px) { .dash-events li { grid-template-columns: 1fr; gap: 0.1rem; } }
  .dash-tag { font-size: 0.75rem; border: 1px solid var(--warn); color: var(--warn); border-radius: 999px; padding: 0 0.45rem; margin-left: 0.25rem; }
  .dash ul.dash-small { padding-left: 1.1rem; }
  .dash-summary { margin: 0; font-size: 1rem; padding-left: 0.75rem; border-left: 4px solid var(--good); }
  .dash-summary[data-state="warn"] { border-left-color: var(--warn); }
  .dash-summary[data-state="bad"] { border-left-color: var(--bad); }

  .dash-incidents { list-style: none; margin: 0.5rem 0; padding: 0; }
  .dash-incidents li { padding: 0.6rem 0; border-bottom: 1px solid var(--line); }
  .dash-incidents li p { margin: 0.15rem 0; }
  .dash-incident-head { font-size: 0.9375rem; }
  .dash-badge { display: inline-block; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.04em; border-radius: 4px; padding: 0.05rem 0.4rem; margin-right: 0.35rem; color: var(--bg); background: var(--none); vertical-align: 0.1rem; }
  .dash-badge[data-state="good"] { background: var(--good); }
  .dash-badge[data-state="bad"] { background: var(--bad); }
  .dash-badge[data-state="warn"] { background: var(--warn); }

  .dash-limits, .dash-usage { list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; gap: 0.6rem; }
  .dash-limits li { border: 1px solid var(--line); border-left: 4px solid var(--none); border-radius: 8px; padding: 0.55rem 0.8rem; }
  .dash-limits li[data-state="good"] { border-left-color: var(--good); }
  .dash-limits li[data-state="warn"] { border-left-color: var(--warn); border-left-style: dashed; }
  .dash-limits li[data-state="bad"] { border-left-color: var(--bad); }
  .dash-limits p { margin: 0.15rem 0; }
  .dash-limit-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem; }
  .dash-sub { font-size: 1rem; margin: 1.25rem 0 0; }
  .dash-usage p { margin: 0 0 0.2rem; }
  .dash-meter { height: 0.45rem; border-radius: 999px; background: var(--surface); overflow: hidden; }
  .dash-meter span { display: block; height: 100%; background: var(--good); }
  .dash-usage li[data-state="warn"] .dash-meter span { background: var(--warn); }
  .dash-usage li[data-state="bad"] .dash-meter span { background: var(--bad); }
</style>
