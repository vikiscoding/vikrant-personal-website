---
// Writing index. Lists Medium posts with date and one claim in the post's own words; links to the canonical URL.
// Never republish full posts here.
import Base from "../../layouts/Base.astro";
import { formatDate, writing } from "../../data/profile";
---

<Base title="Writing · vikrantsingh.fyi" description="Essays on AI in operations: gated agents, review at scale, and owning the change.">
  <h1>Writing</h1>
  <p>Short essays on putting AI into operations without losing who decides.</p>

  <ol class="posts">
    {
      writing.map((p) => (
        <li>
          <h2><a href={p.url}>{p.title}</a></h2>
          <p class="meta"><time class="muted" datetime={p.date}>{formatDate(p.date)}</time></p>
          <p class="claim">{p.claim}</p>
          <p><a href={p.url}>Read on Medium →</a></p>
        </li>
      ))
    }
  </ol>

  <h2 class="also">On this site</h2>
  <ul class="onsite">
    <li><a href="/notes/postmortem-game-day-1/">Postmortem: game day 1</a> <time class="muted" datetime="2026-10-01">· 1 Oct 2026</time>. I broke this site on purpose; eight findings, six fixed.</li>
    <li><a href="/notes/how-this-site-is-run/">How this site is run</a>: the heartbeat, the probe and the objectives behind the <a href="/reliability/">Live reliability</a> page.</li>
  </ul>
</Base>

<style>
  .posts { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1.75rem; }
  .posts h2 { font-size: 1.0625rem; margin: 0; line-height: 1.35; }
  .posts h2 a { color: var(--fg); text-decoration: none; }
  .posts h2 a:hover { text-decoration: underline; }
  .posts p { margin: 0.2rem 0; }
  .meta { font-size: 0.875rem; }
  .claim { font-style: italic; }
  .also { font-size: 1rem; margin: 3rem 0 0.5rem; }
  .onsite { padding-left: 1.1rem; }
  .onsite li { margin: 0.4rem 0; }
</style>
